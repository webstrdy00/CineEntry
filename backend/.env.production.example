# Copy to .env.production on the deployment host. Never commit the populated file.
DEBUG=False
EMAIL_LOG_ONLY=False
API_DOMAIN=api.cineentry.com
BACKEND_PUBLIC_URL=https://api.cineentry.com
FRONTEND_URL=https://app.cineentry.com
CORS_ALLOWED_ORIGINS=https://app.cineentry.com
OAUTH_WEB_CLIENT_ENABLED=False

POSTGRES_USER=cineentry
POSTGRES_DB=cineentry
POSTGRES_PASSWORD=
# URL-encode the same password used by POSTGRES_PASSWORD.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

EMAIL_FROM_ADDRESS=no-reply@cineentry.app
EMAIL_FROM_NAME=CineEntry
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_USE_SSL=False

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
TMDB_API_KEY=
KOBIS_API_KEY=
KMDB_API_KEY=

GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-key.json
GCP_BUCKET_NAME=
GCP_SIGNED_URL_EXPIRATION_SECONDS=900
MAX_IMAGE_UPLOAD_BYTES=5242880
MAX_REQUEST_BODY_SIZE=6MB
